# Python environment & cache
venv/
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# Local validation evidence can contain patient-derived measurements.
/validation/runs/*
!/validation/runs/.gitkeep

.DS_Store
artifacts/

# Secrets & configuration
.env

# Ignore raw local patient data but keep the directory structure
data/raw/*
!data/raw/.gitkeep

# Ignore runtime generated outputs but keep the directory structure
data/processed/*
!data/processed/.gitkeep

/storage/
build/
dist/

# OSI submission: local secrets, caches and all nested raw DICOM inputs
.env
__pycache__/
storage/sessions/*
data/raw/*.dcm
data/raw/**/*.dcm
.pytest_cache/

# Reviewed public report snapshots are distinct from ignored runtime artifacts.
!/validation/evidence/**/artifacts/
/validation/evidence/**/artifacts/*
!/validation/evidence/**/artifacts/*.md
